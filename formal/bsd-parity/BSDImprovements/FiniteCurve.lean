import Mathlib.AlgebraicGeometry.EllipticCurve.Affine.Point
import Mathlib.Algebra.Field.ZMod
import Mathlib.GroupTheory.OrderOfElement
import Mathlib.Tactic.NormNum

/-!
Certificates in Mathlib's actual nonsingular affine-point group for the curve
y² + xy = x³ - x² - 79x + 289. All finite decisions use kernel reduction.
No native_decide, custom axiom, or unproved certificate is used.
Generated by generate_finite_curve.py; the generated file is the proof source.
-/

namespace BSDImprovements

open WeierstrassCurve.Affine

deriving instance DecidableEq for WeierstrassCurve.Affine.Point

def curve (R : Type*) [CommRing R] : WeierstrassCurve.Affine R :=
  ⟨1, -1, 0, -79, 289⟩

def coordinates {R : Type*} [CommRing R] : (curve R).Point → Option (R × R)
  | .zero => none
  | @Point.some _ _ _ x y _ => some (x,y)

theorem coordinates_injective {R : Type*} [CommRing R] :
    Function.Injective (coordinates (R := R)) := by
  intro P Q h
  cases P <;> cases Q <;> simp_all [coordinates]

instance : Fact (Nat.Prime 5) := ⟨by decide⟩

def gen5 : (curve (ZMod 5)).Point :=
  .some (show (curve (ZMod 5)).Nonsingular 1 0 by
    rw [nonsingular_iff, equation_iff]; decide +kernel)

def p1mod5 : (curve (ZMod 5)).Point :=
  .some (show (curve (ZMod 5)).Nonsingular 6 (-1) by
    rw [nonsingular_iff, equation_iff]; decide +kernel)

def p2mod5 : (curve (ZMod 5)).Point :=
  .some (show (curve (ZMod 5)).Nonsingular 4 3 by
    rw [nonsingular_iff, equation_iff]; decide +kernel)

def p3mod5 : (curve (ZMod 5)).Point :=
  .some (show (curve (ZMod 5)).Nonsingular 5 (-2) by
    rw [nonsingular_iff, equation_iff]; decide +kernel)

def p4mod5 : (curve (ZMod 5)).Point :=
  .some (show (curve (ZMod 5)).Nonsingular 7 3 by
    rw [nonsingular_iff, equation_iff]; decide +kernel)

theorem log_p1_mod5 : (9 : ℕ) • gen5 = p1mod5 := by
  decide +kernel

theorem log_p2_mod5 : (5 : ℕ) • gen5 = p2mod5 := by
  decide +kernel

theorem log_p3_mod5 : (8 : ℕ) • gen5 = p3mod5 := by
  decide +kernel

theorem log_p4_mod5 : (7 : ℕ) • gen5 = p4mod5 := by
  decide +kernel

theorem generator_annihilated_mod5 : (10 : ℕ) • gen5 = 0 := by
  decide +kernel

theorem generator_order_mod5 : addOrderOf gen5 = 10 := by
  apply (addOrderOf_eq_iff (by decide : 0 < 10)).mpr
  refine ⟨generator_annihilated_mod5, ?_⟩
  have h : ∀ n : Fin 10, 0 < n.val → n.val • gen5 ≠ 0 := by decide +kernel
  intro n hn hpos
  exact h ⟨n, hn⟩ hpos

theorem coordinates_exhaustive_mod5 :
    ∀ x y : ZMod 5, y^2 + x*y = x^3 - x^2 - 79*x + 289 →
      ∃ n : Fin 10, coordinates (n.val • gen5) = some (x,y) := by
  decide +kernel

theorem generator_surjective_mod5 :
    Function.Surjective (fun n : Fin 10 => n.val • gen5) := by
  intro P
  cases P with
  | zero => exact ⟨0, by simp [Point.zero_def]⟩
  | @some x y h =>
    have heq := (equation_iff ..).mp h.left
    have heq' : y^2 + x*y = x^3 - x^2 - 79*x + 289 := by
      simpa [curve, sub_eq_add_neg] using heq
    obtain ⟨n, hn⟩ := coordinates_exhaustive_mod5 x y heq'
    exact ⟨n, coordinates_injective hn⟩

theorem generator_injective_mod5 :
    Function.Injective (fun n : Fin 10 => n.val • gen5) := by
  intro a b h
  apply Fin.ext
  apply nsmul_injOn_Iio_addOrderOf (x := gen5) _ _ h
  · simp [generator_order_mod5]
  · simp [generator_order_mod5]

noncomputable def finiteCurveEquiv5 : Fin 10 ≃ (curve (ZMod 5)).Point :=
  Equiv.ofBijective _ ⟨generator_injective_mod5, generator_surjective_mod5⟩

noncomputable instance : Fintype (curve (ZMod 5)).Point :=
  Fintype.ofEquiv (Fin 10) finiteCurveEquiv5

theorem curve_card_mod5 : Fintype.card (curve (ZMod 5)).Point = 10 := by
  rw [← Fintype.card_congr finiteCurveEquiv5]
  simp

